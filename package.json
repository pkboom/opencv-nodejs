{
  "name": "@pkboom/opencv-nodejs",
  "version": "7.1.2",
  "description": "Asynchronous OpenCV 4.x nodejs bindings with JavaScript and TypeScript API.",
  "keywords": [
    "opencv",
    "cv",
    "computer vision",
    "face",
    "detection",
    "recognition",
    "machine",
    "learning",
    "neural",
    "network",
    "async",
    "typescript"
  ],
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./typings/index.d.ts",
      "require": "./cjs/lib/opencv-nodejs.js",
      "import": "./esm/lib/opencv-nodejs.js"
    }
  },
  "contributors": [
    "Uriel Chemouni <uchemouni@gmail.com> (https://uriel.ovh/)",
    "justadudewhohacks (https://github.com/justadudewhohacks)"
  ],
  "funding": "https://github.com/sponsors/urielch",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pkboom/opencv-nodejs"
  },
  "bugs": {
    "url": "https://github.com/pkboom/opencv-nodejs/issues"
  },
  "bin": {
    "build-opencv": "bin/install.js"
  },
  "homepage": "https://github.com/pkboom/opencv-nodejs#readme",
  "main": "./cjs/lib/opencv-nodejs.js",
  "module": "./esm/lib/opencv-nodejs.js",
  "typings": "./typings/index.d.ts",
  "scripts": {
    "install": "node bin/install.js rebuild",
    "build": "tsc --pretty --project tsconfig.json && tsc --pretty --project tsconfig-esm.json && npm run copyfile",
    "build-types": "rimraf types && tsc --noCheck --pretty --project tsconfig-types.json",
    "copyfile": "shx cp extra/meta.mjs esm/lib/meta.js && shx cp extra/meta.cjs cjs/lib/meta.js",
    "prepack": "npm run build",
    "test": "cd test && pnpm install && pnpm run test",
    "samples": "cd examples && pnpm install && npm run build && node ./src/templateMatch/multiMatchBench.js && node ./src/templateMatch/multiMatchColision.js && node ./src/applyColorMap.js && node ./src/asyncMatchFeatures.js && node ./src/faceDetect/asyncFaceDetection.js",
    "lint": "eslint examples/**/*.ts src/**/*.ts typings/**/*.ts ",
    "fmt": "clang-format -i **/*.h **/*.cc",
    "clean": "node bin/install.js clean",
    "rebuild": "node bin/install.js rebuild",
    "cleanjs": "rimraf {examples}/**/*.{d.ts,js,map} {cjs,esm}/{lib,install}",
    "build-debug": "npm run build && node bin/install.js --debug rebuild",
    "checkExports": "npx @arethetypeswrong/cli $(npm pack)",
    "ncu": "npx --yes npm-check-updates -i",
    "publish-next": "npm publish --dry-run --tag next",
    "info": "node bin/install.js info"
  },
  "dependencies": {
    "nan": "^2.28.0",
    "node-gyp": "^13.0.2",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@types/node": "^26.4.1",
    "eslint": "^9.10.0",
    "rimraf": "^6.0.1",
    "shx": "^0.3.4",
    "typescript": "^5.6.2",
    "typescript-eslint": "8.5.0"
  },
  "files": [
    "cc",
    "cjs",
    "esm",
    "src/**/*.xml",
    "bin/*.js",
    "typings",
    "types",
    "binding.gyp"
  ]
}
